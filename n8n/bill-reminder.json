{
  "id": "BillWiseReminder1",
  "name": "BillWise - due date reminder",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "3f1c2a10-0001-4b6e-9a01-000000000001",
      "name": "Bill saved (webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "6d1e0f3a-6a43-4f6b-9b44-2b7c5b1e0a11",
      "parameters": {
        "httpMethod": "POST",
        "path": "bill-reminder",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "3f1c2a10-0002-4b6e-9a01-000000000002",
      "name": "Wait until 3 days before due date",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [260, 0],
      "webhookId": "9a7b2c4d-1e2f-4a5b-8c6d-7e8f9a0b1c2d",
      "parameters": {
        "resume": "specificTime",
        "dateTime": "={{ DateTime.fromISO($json.body.due_date).minus({ days: 3 }).set({ hour: 9 }).toISO() }}"
      }
    },
    {
      "id": "3f1c2a10-0003-4b6e-9a01-000000000003",
      "name": "Send reminder email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [520, 0],
      "parameters": {
        "fromEmail": "billwise@example.com",
        "toEmail": "you@example.com",
        "subject": "={{ 'Electricity bill due ' + $('Bill saved (webhook)').item.json.body.due_date + ': Rs ' + $('Bill saved (webhook)').item.json.body.amount }}",
        "emailFormat": "text",
        "text": "={{ 'Your electricity bill for account ' + $('Bill saved (webhook)').item.json.body.account_no + ' is due on ' + $('Bill saved (webhook)').item.json.body.due_date + '.\\nAmount: Rs ' + $('Bill saved (webhook)').item.json.body.amount + ' for ' + $('Bill saved (webhook)').item.json.body.units + ' units.\\n\\n' + $('Bill saved (webhook)').item.json.body.explanation }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Bill saved (webhook)": {
      "main": [[{ "node": "Wait until 3 days before due date", "type": "main", "index": 0 }]]
    },
    "Wait until 3 days before due date": {
      "main": [[{ "node": "Send reminder email", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {}
}
