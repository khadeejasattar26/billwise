# Copy to backend/.env. Never commit backend/.env.
DATABASE_URL=postgresql://billwise:billwise@localhost:5433/billwise
# Which LLM to use: ollama (free, local, default) or openai (paid, needs a key).
LLM_PROVIDER=ollama

# Local LLM server (free, no API key). Install: brew install ollama && ollama pull qwen2.5vl:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
# Only used when LLM_PROVIDER=openai. OPENAI_MODEL must be a vision-capable model your key can use.
OPENAI_API_KEY=
OPENAI_MODEL=

# Leave empty to skip the n8n reminder.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/bill-reminder
FRONTEND_ORIGIN=http://localhost:5173

# Public-site protection (see backend/app/ratelimit.py). Use RATE_LIMITS=off for local development.
RATE_LIMITS=on
UPLOADS_PER_HOUR=5
UPLOADS_PER_DAY_TOTAL=50
ASKS_PER_HOUR=20
SPEECH_PER_HOUR=30
# Bills are deleted this many days after upload.
RETENTION_DAYS=30
# Deployment only: create tables on startup, and serve the built React site from this folder.
# AUTO_MIGRATE=1
# FRONTEND_DIST=/app/frontend_dist
